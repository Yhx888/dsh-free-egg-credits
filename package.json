{
  "name": "dsh-free-egg-credits",
  "version": "1.6.0",
  "type": "module",
  "description": "Free Egg 积分：在 DSH 侧边栏查看 WorkBuddy / Qoder 账号积分、今日额度、签到状态与每轮消耗，支持一键切换优先消耗平台，并附网关 + New API 一键部署脚本。",
  "license": "MIT",
  "author": "dsh-free-egg-credits contributors",
  "homepage": "https://github.com/Yhx888/dsh-free-egg-credits#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yhx888/dsh-free-egg-credits.git"
  },
  "bugs": {
    "url": "https://github.com/Yhx888/dsh-free-egg-credits/issues"
  },
  "main": "./index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/session-credits.test.mjs && node test/refresh.test.mjs && node test/qoder-checkin.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "free-egg",
    "free-tier",
    "workbuddy",
    "qoder",
    "credits",
    "quota",
    "balance",
    "checkin",
    "sidebar",
    "one-click",
    "installer"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "install/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
